Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^webroot/ - [L]
    RewriteRule ^assets/(.+)$ /webroot/assets/$1 [END]
    RewriteRule ^robots\.txt$ /webroot/robots.txt [END]
    RewriteRule ^$ /webroot/index.php [PT,L]

    RewriteCond %{DOCUMENT_ROOT}/webroot%{REQUEST_URI} -f
    RewriteRule ^(.+)$ webroot/$1 [END]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [F,L]

    RewriteRule ^ /webroot/index.php [QSA,PT,L]
</IfModule>
