<?xml version="1.0"?>
<ruleset name="Harfusha Lab">
    <description>CakePHP coding standard for application and PHPUnit code.</description>
    <rule ref="CakePHP"/>
    <file>src/</file>
    <file>tests/</file>
    <arg name="warning-severity" value="0"/>
    <!-- This self-contained fallback harness deliberately defines global polyfills and helper classes.
         It has separate standalone and syntax tests rather than application-class naming rules. -->
    <exclude-pattern>*/tests/standalone.php</exclude-pattern>
</ruleset>
